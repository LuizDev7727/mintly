# Copie para `.env` (que o git ignora) e preencha. O .env fica SÓ no PC de teste,
# com `chmod 600`. Nunca coloque o token do Alloy no GitHub nem no repo.
#
# Onde achar cada valor: Grafana Cloud > Connections > Hosted Prometheus metrics /
# Hosted logs (Loki) > Details.

# Prometheus (remote write). Termina em /api/prom/push.
GRAFANA_PROM_URL=
# Usuário numérico do Prometheus.
GRAFANA_PROM_USER=

# Loki. Termina em /loki/api/v1/push.
GRAFANA_LOKI_URL=
# Usuário numérico do Loki (diferente do do Prometheus).
GRAFANA_LOKI_USER=

# Access policy token `mintly-perf-alloy` (escopos metrics:write e logs:write).
GRAFANA_ALLOY_TOKEN=
